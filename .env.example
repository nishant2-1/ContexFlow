# Server
PORT=3000
NODE_ENV=development
BASE_URL=http://localhost:3000

# Persistence (file|postgres)
PERSISTENCE_DRIVER=file
POSTGRES_URL=

# Slack (only needed for real Slack webhook integration)
# Create an app at https://api.slack.com/apps
# Find these in: Basic Information and OAuth & Permissions
SLACK_SIGNING_SECRET=your_slack_signing_secret
SLACK_BOT_TOKEN=xoxb-your-token
SLACK_WORKSPACE_ID=

# Discord (optional, only if you wire real Discord events)
DISCORD_WEBHOOK_SECRET=your_discord_webhook_secret

# AI
# Demo mode: keep MOCK_AI=true and you do not need OpenAI or Gemini keys
# OpenAI key: https://platform.openai.com/api-keys
# Gemini key: https://aistudio.google.com/app/apikey
AI_PROVIDER=openai
OPENAI_API_KEY=
GOOGLE_API_KEY=
MOCK_AI=true

# Mock issue mode
# Keep MOCK_ISSUE=true to make the project run without Trello or Jira accounts
MOCK_ISSUE=true

# Issue provider (trello|jira)
ISSUE_PROVIDER=trello

# Trello (only needed when MOCK_ISSUE=false and ISSUE_PROVIDER=trello)
# API key + token: https://trello.com/app-key
# TRELLO_LIST_ID: open the target list/board or fetch via Trello API
TRELLO_API_KEY=
TRELLO_TOKEN=
TRELLO_LIST_ID=

# Jira (only needed when MOCK_ISSUE=false and ISSUE_PROVIDER=jira)
# API token: https://id.atlassian.com/manage-profile/security/api-tokens
# JIRA_BASE_URL example: https://your-domain.atlassian.net
JIRA_BASE_URL=https://your-domain.atlassian.net
JIRA_USER_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=
JIRA_ISSUE_TYPE=Task

# Pipeline
ENABLE_DISCORD=true
ENABLE_SLACK=true
APPROVAL_MODE=off
APPROVAL_MIN_PRIORITY=high
REQUIRED_REACTION=white_check_mark
PIPELINE_TIMEOUT_MS=30000
MAX_MESSAGES_FOR_CONTEXT=30

# Queue driver (inline|bullmq|sqs|kafka)
# Keep QUEUE_DRIVER=inline for easiest local setup.
QUEUE_DRIVER=inline
DEPLOY_REGION=local

# BullMQ
REDIS_URL=redis://localhost:6379
QUEUE_CONCURRENCY=4
QUEUE_ATTEMPTS=3

# SQS (comma-separated queue URLs supports multi-region fanout)
AWS_REGION=us-east-1
SQS_QUEUE_URLS=
SQS_MAX_MESSAGES=5
SQS_WAIT_TIME_SECONDS=10

# Kafka
KAFKA_BROKERS=
KAFKA_TOPIC=contextflow-workflow-events
KAFKA_REPLICA_TOPICS=
KAFKA_GROUP_ID=contextflow-workers

# Workspace policy and run persistence
WORKSPACE_POLICY_FILE=data/workspace-policies.json
WORKFLOW_RUN_LOG_PATH=data/workflow-runs.jsonl

# Ops API RBAC (optional, leave empty for local open mode)
OPS_VIEWER_API_KEY=
OPS_ADMIN_API_KEY=
