# Server
PORT=3000
NODE_ENV=development
BASE_URL=http://localhost:3000

# Slack
SLACK_SIGNING_SECRET=your_slack_signing_secret
SLACK_BOT_TOKEN=xoxb-your-token
SLACK_WORKSPACE_ID=

# Discord (optional)
DISCORD_WEBHOOK_SECRET=your_discord_webhook_secret

# AI
AI_PROVIDER=openai
OPENAI_API_KEY=
GOOGLE_API_KEY=
MOCK_AI=true

# Trello
TRELLO_API_KEY=
TRELLO_TOKEN=
TRELLO_LIST_ID=

# Pipeline
ENABLE_DISCORD=true
ENABLE_SLACK=true
REQUIRED_REACTION=white_check_mark
PIPELINE_TIMEOUT_MS=30000
MAX_MESSAGES_FOR_CONTEXT=30
