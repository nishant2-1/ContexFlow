# Server
PORT=3000
NODE_ENV=development
BASE_URL=http://localhost:3000

# Slack
SLACK_SIGNING_SECRET=your_slack_signing_secret
SLACK_BOT_TOKEN=xoxb-your-token
SLACK_WORKSPACE_ID=

# Discord (optional)
DISCORD_WEBHOOK_SECRET=your_discord_webhook_secret

# AI
AI_PROVIDER=openai
OPENAI_API_KEY=
GOOGLE_API_KEY=
MOCK_AI=true

# Issue provider (trello|jira)
ISSUE_PROVIDER=trello

# Trello
TRELLO_API_KEY=
TRELLO_TOKEN=
TRELLO_LIST_ID=

# Jira (optional)
JIRA_BASE_URL=https://your-domain.atlassian.net
JIRA_USER_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=
JIRA_ISSUE_TYPE=Task

# Pipeline
ENABLE_DISCORD=true
ENABLE_SLACK=true
REQUIRED_REACTION=white_check_mark
PIPELINE_TIMEOUT_MS=30000
MAX_MESSAGES_FOR_CONTEXT=30

# Queue driver (inline|bullmq)
QUEUE_DRIVER=inline
REDIS_URL=redis://localhost:6379
QUEUE_CONCURRENCY=4
QUEUE_ATTEMPTS=3

# Workspace policy and run persistence
WORKSPACE_POLICY_FILE=data/workspace-policies.json
WORKFLOW_RUN_LOG_PATH=data/workflow-runs.jsonl

# Ops API RBAC (optional, leave empty for local open mode)
OPS_VIEWER_API_KEY=
OPS_ADMIN_API_KEY=
